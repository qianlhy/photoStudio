.login.data-v-b237504c {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #F3EEE4 0%, #EAF1FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-card.data-v-b237504c {
  width: 720rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 64rpx 64rpx 56rpx;
  box-shadow: 0 24rpx 60rpx rgba(31, 39, 51, 0.12);
  text-align: center;
}
.logo.data-v-b237504c {
  font-size: 52rpx;
  font-weight: 700;
  color: #202938;
  letter-spacing: 4rpx;
}
.slogan.data-v-b237504c {
  font-size: 26rpx;
  color: #8C98A9;
  margin-top: 12rpx;
  margin-bottom: 56rpx;
}
.field.data-v-b237504c {
  display: flex;
  align-items: center;
  height: 96rpx;
  border: 1rpx solid #E9EDF3;
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 28rpx;
  background: #FAFBFD;
}
.field .ico.data-v-b237504c {
  position: relative;
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  color: #A6B0C0;
}
.ico-user.data-v-b237504c::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 3rpx;
  width: 13rpx;
  height: 13rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.ico-user.data-v-b237504c::after {
  content: "";
  position: absolute;
  left: 4rpx;
  bottom: 3rpx;
  width: 25rpx;
  height: 14rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 14rpx 14rpx 5rpx 5rpx;
}
.ico-lock.data-v-b237504c::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 3rpx;
  width: 15rpx;
  height: 13rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
}
.ico-lock.data-v-b237504c::after {
  content: "";
  position: absolute;
  left: 4rpx;
  bottom: 3rpx;
  width: 25rpx;
  height: 16rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}
.input.data-v-b237504c {
  flex: 1;
  font-size: 30rpx;
  color: #202938;
}
.ph.data-v-b237504c {
  color: #B9C0CC;
}
.btn-login.data-v-b237504c {
  height: 96rpx;
  line-height: 96rpx;
