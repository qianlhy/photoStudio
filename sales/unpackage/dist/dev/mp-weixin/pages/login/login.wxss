  background: #2F6BFF;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(47, 107, 255, 0.28);
}
.tip.data-v-b237504c {
