<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.ChengpinDao">

    <resultMap type="com.entity.ChengpinEntity" id="chengpinMap">
        <result property="dingdanid" column="dingdanid"/>
        <result property="dingdanbianhao" column="dingdanbianhao"/>
        <result property="taocanmingcheng" column="taocanmingcheng"/>
        <result property="userid" column="userid"/>
        <result property="xingming" column="xingming"/>
        <result property="biaoti" column="biaoti"/>
        <result property="tupian" column="tupian"/>
        <result property="shipin" column="shipin"/>
        <result property="shangxiajia" column="shangxiajia"/>
        <result property="beizhu" column="beizhu"/>
    </resultMap>

    <select id="selectListVO" resultType="com.entity.vo.ChengpinVO">
        SELECT * FROM chengpin chengpin
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectVO" resultType="com.entity.vo.ChengpinVO">
        SELECT chengpin.* FROM chengpin chengpin
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectListView" resultType="com.entity.view.ChengpinView">
        SELECT chengpin.* FROM chengpin chengpin
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectView" resultType="com.entity.view.ChengpinView">
        SELECT * FROM chengpin chengpin <where> 1=1 ${ew.sqlSegment}</where>
    </select>

</mapper>
