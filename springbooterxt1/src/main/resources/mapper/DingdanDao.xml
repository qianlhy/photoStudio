<mapper namespace="com.dao.DingdanDao">

    <resultMap type="com.entity.DingdanEntity" id="dingdanMap">
        <result property="dingdanbianhao" column="dingdanbianhao"/>
        <result property="taocanid" column="taocanid"/>
        <result property="taocanmingcheng" column="taocanmingcheng"/>
        <result property="fengmian" column="fengmian"/>
        <result property="pinlei" column="pinlei"/>
