        SELECT dingdan.* FROM dingdan dingdan
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectListView" resultType="com.entity.view.DingdanView">
        SELECT dingdan.* FROM dingdan dingdan
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectView" resultType="com.entity.view.DingdanView">
        SELECT * FROM dingdan dingdan <where> 1=1 ${ew.sqlSegment}</where>
    </select>

</mapper>
