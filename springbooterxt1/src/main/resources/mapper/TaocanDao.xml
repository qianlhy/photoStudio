<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.TaocanDao">

    <resultMap type="com.entity.TaocanEntity" id="taocanMap">
        <result property="taocanmingcheng" column="taocanmingcheng"/>
        <result property="pinlei" column="pinlei"/>
        <result property="fengge" column="fengge"/>
        <result property="fengmian" column="fengmian"/>
        <result property="shipin" column="shipin"/>
        <result property="jianjie" column="jianjie"/>
        <result property="xianxiabiaojia" column="xianxiabiaojia"/>
        <result property="fuzhuangshuliang" column="fuzhuangshuliang"/>
        <result property="jingxiuzhangshu" column="jingxiuzhangshu"/>
        <result property="paishishichang" column="paishishichang"/>
        <result property="shengjixiangmu" column="shengjixiangmu"/>
        <result property="shctp" column="shctp"/>
        <result property="shangxiajia" column="shangxiajia"/>
        <result property="paixu" column="paixu"/>
        <result property="clicknum" column="clicknum"/>
    </resultMap>

    <select id="selectListVO" resultType="com.entity.vo.TaocanVO">
        SELECT * FROM taocan taocan
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectVO" resultType="com.entity.vo.TaocanVO">
        SELECT taocan.* FROM taocan taocan
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectListView" resultType="com.entity.view.TaocanView">
        SELECT taocan.* FROM taocan taocan
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectView" resultType="com.entity.view.TaocanView">
        SELECT * FROM taocan taocan <where> 1=1 ${ew.sqlSegment}</where>
    </select>

</mapper>
