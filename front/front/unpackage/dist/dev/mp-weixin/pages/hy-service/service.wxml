<view class="page data-v-99dc9d50"><view class="bg data-v-99dc9d50"></view><scroll-view class="scroll data-v-99dc9d50" scroll-y="{{true}}"><view class="head data-v-99dc9d50"><view class="brand data-v-99dc9d50">{{brandName}}</view><image class="avatar data-v-99dc9d50" src="{{avatar}}" mode="aspectFill"></image></view><view class="title data-v-99dc9d50">我的服务</view><view class="subtitle data-v-99dc9d50">本次内容正在制作中</view><view class="reserve data-v-99dc9d50"><view class="rv-top data-v-99dc9d50"><text class="rv-l data-v-99dc9d50">{{"储备 "+reservePct+"%"}}</text><text class="rv-r data-v-99dc9d50">{{"可用 "+remain+"/"+totalQuota+"条 · "+producing+"条制作中"}}</text></view><view class="rv-bar data-v-99dc9d50"><view class="rv-in data-v-99dc9d50" style="{{'width:'+(reservePct+'%')+';'}}"></view></view><text class="rv-note data-v-99dc9d50">实心为可用 · 条纹为制作中</text></view><view class="cur card data-v-99dc9d50"><view class="cur-row data-v-99dc9d50"><text class="cur-tag data-v-99dc9d50">当前服务</text><text class="cur-badge data-v-99dc9d50">进度正常</text></view><view class="cur-title data-v-99dc9d50">{{"第"+batch+"批 · "+(order.status||'制作中')}}</view><text class="cur-sub data-v-99dc9d50">{{(order.videoCount||0)+"条视频 · 预计"+deliverText+"交付"}}</text><view class="cur-prog data-v-99dc9d50"><text class="cp-l data-v-99dc9d50">{{"已完成 "+(order.completedCount||0)+"/"+(order.videoCount||0)}}</text><view class="cp-bar data-v-99dc9d50"><view class="cp-in data-v-99dc9d50" style="{{'width:'+(donePct+'%')+';'}}"></view></view></view></view><view class="steps card data-v-99dc9d50"><text class="blk-title data-v-99dc9d50">服务进度</text><block wx:for="{{steps}}" wx:for-item="s" wx:for-index="i" wx:key="i"><view class="step data-v-99dc9d50"><view class="st-left data-v-99dc9d50"><view class="{{['st-dot','data-v-99dc9d50',(s.state==='done')?'done':'',(s.state==='cur')?'cur':'']}}"><block wx:if="{{s.state==='done'}}"><text class="data-v-99dc9d50">✓</text></block><block wx:else><text class="data-v-99dc9d50">{{i+1}}</text></block