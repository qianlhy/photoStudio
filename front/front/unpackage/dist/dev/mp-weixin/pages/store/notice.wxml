<view class="page data-v-6d5ab1bf"><view class="card data-v-6d5ab1bf"><view class="store-name data-v-6d5ab1bf">{{cfg.storeName||'照相馆'}}</view><view class="store-row data-v-6d5ab1bf"><text class="lbl data-v-6d5ab1bf">地址</text><text class="val data-v-6d5ab1bf">{{cfg.storeAddress}}</text></view><view class="store-row data-v-6d5ab1bf"><text class="lbl data-v-6d5ab1bf">营业时间</text><text class="val data-v-6d5ab1bf">{{cfg.storeBusinessHours}}</text></view><view class="store-row data-v-6d5ab1bf"><text class="lbl data-v-6d5ab1bf">联系电话</text><text data-event-opts="{{[['tap',[['call',['$event']]]]]}}" class="val phone data-v-6d5ab1bf" bindtap="__e">{{cfg.storePhone}}</text></view><block wx:if="{{cfg.storeLng&&cfg.storeLat}}"><button data-event-opts="{{[['tap',[['openMap',['$event']]]]]}}" class="nav-btn data-v-6d5ab1bf" bindtap="__e">导航到店</button></block></view><view class="card data-v-6d5ab1bf"><view class="sec-title data-v-6d5ab1bf">取消与扣费规则</view><text class="rule data-v-6d5ab1bf">{{cfg.cancelRule||'暂未设置'}}</text></view><view class="card data-v-6d5ab1bf"><view class="sec-title data-v-6d5ab1bf">排队规则</view><text class="rule data-v-6d5ab1bf">{{cfg.queueRule||'暂未设置'}}</text></view></view>